{
  "$schema": "https://schema.agentcore.aws.dev/v1/agentcore.json",
  "name": "Wordle",
  "version": 1,
  "managedBy": "CDK",
  "tags": {
    "agentcore:created-by": "agentcore-cli",
    "agentcore:project-name": "Wordle"
  },
  "runtimes": [
    {
      "name": "Wordle",
      "build": "CodeZip",
      "entrypoint": "main.py",
      "codeLocation": "app/Wordle/",
      "runtimeVersion": "PYTHON_3_14",
      "envVars": [
        {
          "name": "REASONING_EFFORT",
          "value": "low"
        },
        {
          "name": "REASONING_PROMPT_HINT",
          "value": "true"
        }
      ],
      "networkMode": "PUBLIC",
      "protocol": "HTTP"
    }
  ],
  "memories": [],
  "knowledgeBases": [],
  "credentials": [],
  "evaluators": [],
  "onlineEvalConfigs": [],
  "agentCoreGateways": [],
  "policyEngines": [],
  "configBundles": [],
  "abTests": [],
  "harnesses": [],
  "datasets": [],
  "payments": []
}